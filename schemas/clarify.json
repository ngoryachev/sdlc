{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": [
    "title",
    "questions",
    "suggestedPrompt",
    "assumptions"
  ],
  "additionalProperties": false,
  "properties": {
    "title": {
      "type": "string",
      "maxLength": 70
    },
    "branch": {
      "type": "string",
      "maxLength": 40,
      "description": "2-5 English words, lowercase, hyphen-separated; used as the git branch name"
    },
    "questions": {
      "type": "array",
      "maxItems": 4,
      "items": {
        "type": "object",
        "required": [
          "question",
          "header"
        ],
        "additionalProperties": false,
        "properties": {
          "question": {
            "type": "string"
          },
          "header": {
            "type": "string",
            "maxLength": 12
          },
          "options": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "maxItems": 4
          }
        }
      }
    },
    "suggestedPrompt": {
      "type": "string"
    },
    "assumptions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
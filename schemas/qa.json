{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["verdict", "summary", "checks", "issues"],
  "additionalProperties": false,
  "properties": {
    "verdict": { "type": "string", "enum": ["pass", "issues", "skipped"] },
    "summary": { "type": "string" },
    "checks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "method", "result"],
        "additionalProperties": false,
        "properties": {
          "name": { "type": "string" },
          "method": { "type": "string" },
          "result": { "type": "string", "enum": ["ok", "failed", "not_run"] }
        }
      }
    },
    "issues": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["severity", "title", "description"],
        "additionalProperties": false,
        "properties": {
          "severity": { "type": "string", "enum": ["blocking", "should_fix", "nit"] },
          "title": { "type": "string" },
          "description": { "type": "string" }
        }
      }
    }
  }
}
